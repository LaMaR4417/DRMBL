{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/tracker/(.*)", "destination": "/tracker/index.html" },
    { "source": "/simple-tracker/(.*)", "destination": "/simple-tracker/index.html" },
    { "source": "/lomba-recorder/simple/(.*)", "destination": "/lomba-recorder/simple/index.html" },
    { "source": "/lomba-recorder/scheduler/(.*)", "destination": "/lomba-recorder/scheduler/index.html" },
    { "source": "/drmbl-recorder/all-star", "destination": "/drmbl-recorder/all-star/" },
    { "source": "/drmbl-recorder/all-star/(.*)", "destination": "/drmbl-recorder/all-star/" },
    { "source": "/drmbl-recorder/full/(.*)", "destination": "/drmbl-recorder/full/index.html" },
    { "source": "/drmbl-recorder/retro-fill/(.*)", "destination": "/drmbl-recorder/retro-fill/index.html" },
    { "source": "/lomba-recorder/(.*)", "destination": "/lomba-recorder/index.html" },
    { "source": "/l3x3-recorder/simple/(.*)", "destination": "/l3x3-recorder/simple/index.html" },
    { "source": "/api/season", "destination": "/api/seasons" }
  ]
}
